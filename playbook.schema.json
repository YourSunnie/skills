{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.yoursunnie.com/playbook.schema.json",
  "title": "PLAYBOOK.json",
  "description": "What a skill keeps, watches and does unasked. Kept in step by hand with Sunnie's src/playbooks/format.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "for", "summary"],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$" },
    "ident": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
    "records": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}\\.[a-z][a-z0-9_]{0,39}$" },
    "at": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "interval": { "type": "integer", "minimum": 1, "maximum": 52 },
    "repeat": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["every", "at"], "properties": { "every": { "const": "day" }, "interval": { "$ref": "#/$defs/interval" }, "at": { "$ref": "#/$defs/at" } } },
        { "type": "object", "additionalProperties": false, "required": ["every", "days", "at"], "properties": { "every": { "const": "week" }, "interval": { "$ref": "#/$defs/interval" }, "days": { "type": "array", "minItems": 1, "maxItems": 7, "items": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] } }, "at": { "$ref": "#/$defs/at" } } },
        { "type": "object", "additionalProperties": false, "required": ["every", "day", "at"], "properties": { "every": { "const": "month" }, "interval": { "$ref": "#/$defs/interval" }, "day": { "type": "integer", "minimum": -1, "maximum": 28 }, "at": { "$ref": "#/$defs/at" } } }
      ]
    }
  },
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "for": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 60 } },
    "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
    "asks": { "type": "array", "maxItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["id", "question", "why"], "properties": {
      "id": { "$ref": "#/$defs/id" }, "question": { "type": "string", "minLength": 1, "maxLength": 200 }, "why": { "type": "string", "minLength": 1, "maxLength": 200 } } } },
    "homework": { "type": "array", "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["id", "find"], "properties": {
      "id": { "$ref": "#/$defs/id" }, "find": { "type": "string", "minLength": 1, "maxLength": 200 }, "keep": { "type": "string", "maxLength": 60 } } } },
    "records": { "type": "array", "maxItems": 12, "items": { "type": "object", "additionalProperties": false, "required": ["database", "table", "columns"], "properties": {
      "database": { "$ref": "#/$defs/id" }, "table": { "$ref": "#/$defs/ident" },
      "columns": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "type": "object", "additionalProperties": false, "required": ["name", "type"], "properties": {
        "name": { "$ref": "#/$defs/ident" }, "type": { "enum": ["text", "number", "date", "datetime"] } } } },
      "key": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/ident" } } } } },
    "senses": { "type": "array", "maxItems": 12, "items": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "describe", "ask"], "properties": {
      "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["address", "mail", "site", "hook", "calendar"] },
      "describe": { "type": "string", "minLength": 1, "maxLength": 200 }, "ask": { "type": "string", "minLength": 1, "maxLength": 200 },
      "match": { "type": "object", "additionalProperties": false, "properties": {
        "from": { "type": "string", "maxLength": 120 }, "subject": { "type": "string", "maxLength": 120 },
        "kind": { "enum": ["report", "invoice", "receipt", "booking", "message", "notice", "statement", "alert", "invitation", "other"] } } },
      "into": { "$ref": "#/$defs/records" } } } },
    "rhythms": { "type": "array", "maxItems": 12, "items": { "type": "object", "additionalProperties": false, "required": ["id", "when", "do"], "properties": {
      "id": { "$ref": "#/$defs/id" },
      "when": { "oneOf": [ { "$ref": "#/$defs/repeat" }, { "type": "object", "additionalProperties": false, "required": ["on"], "properties": { "on": { "type": "string", "pattern": "^sense:[a-z][a-z0-9_-]{0,39}$" } } } ] },
      "do": { "type": "string", "minLength": 1, "maxLength": 600 },
      "needs": { "type": "array", "maxItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["records", "freshHours"], "properties": {
        "records": { "$ref": "#/$defs/records" }, "freshHours": { "type": "integer", "minimum": 1, "maximum": 720 } } } },
      "say": { "enum": ["always", "if-notable", "never"] } } } },
    "signals": { "type": "array", "maxItems": 12, "items": { "type": "object", "additionalProperties": false, "required": ["id", "when", "say"], "properties": {
      "id": { "$ref": "#/$defs/id" }, "when": { "type": "string", "minLength": 1, "maxLength": 200 }, "say": { "type": "string", "minLength": 1, "maxLength": 300 },
      "check": { "type": "object", "additionalProperties": false, "required": ["database", "sql"], "properties": {
        "database": { "$ref": "#/$defs/id" }, "sql": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^\\s*(?:[Ss][Ee][Ll][Ee][Cc][Tt]|[Ww][Ii][Tt][Hh])\\b" } } } } } },
    "prepare": { "type": "array", "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["id", "when", "action", "describe"], "properties": {
      "id": { "$ref": "#/$defs/id" }, "when": { "type": "string", "minLength": 1, "maxLength": 200 },
      "action": { "enum": ["mail_send", "gmail_send", "google_calendar_change", "calendar_change", "phone_action"] },
      "describe": { "type": "string", "minLength": 1, "maxLength": 300 } } } }
  }
}
